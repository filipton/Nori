<?xml version="1.0" encoding="utf-8"?>
<!--
  A nigiri whose sides are vinyl: the rice rim, the groove arcs top and bottom, the label at the
  middle. Redrawn from the author's sketch as clean centred vectors (the sketch sat off-centre, so
  there is no mirrored variant to keep) inside the 72dp safe zone, so no launcher mask can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- rice rim -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M34,54 a20,31 0 1,0 40,0 a20,31 0 1,0 -40,0" />
    <!-- nori -->
    <path android:fillColor="#FF0C130E"
        android:pathData="M37,54 a17,28 0 1,0 34,0 a17,28 0 1,0 -34,0" />
    <!-- grooves -->
    <path android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="1.5" android:strokeLineCap="round"
        android:pathData="M44.13,48.08 A10.5,17.3 0 0,1 63.87,48.08" />
    <path android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="1.5" android:strokeLineCap="round"
        android:pathData="M42.25,46.95 A12.5,20.6 0 0,1 65.75,46.95" />
    <path android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="1.5" android:strokeLineCap="round"
        android:pathData="M40.37,45.83 A14.5,23.9 0 0,1 67.63,45.83" />
    <path android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="1.5" android:strokeLineCap="round"
        android:pathData="M63.87,59.92 A10.5,17.3 0 0,1 44.13,59.92" />
    <path android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="1.5" android:strokeLineCap="round"
        android:pathData="M65.75,61.05 A12.5,20.6 0 0,1 42.25,61.05" />
    <path android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="1.5" android:strokeLineCap="round"
        android:pathData="M67.63,62.17 A14.5,23.9 0 0,1 40.37,62.17" />
    <!-- label -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M48.5,54 a5.5,9 0 1,0 11,0 a5.5,9 0 1,0 -11,0" />
