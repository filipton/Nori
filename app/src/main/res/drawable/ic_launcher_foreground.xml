<!--
  A maki roll lying on its side, its cut face a vinyl record: the nori body, the rim, the groove
  arcs top and bottom, the label at the middle. Redrawn from the author's sketch as clean centred
  vectors (the sketch sat off-centre and leaned on embedded raster brushwork, so there is no
  mirrored variant to keep) inside the 72dp safe zone, so no launcher mask can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
